#!/bin/bash
#??Change to a specific branch, stash changes if needed, and return to the original branch
#&&git,mshx
###Usage: git-checkout-tmp <branch_name>

branch_name=$1

if [ -z "$branch_name" ]; then
    echo "Usage: $0 <branch_name>"
    exit 1
fi

current_branch=$(git rev-parse --abbrev-ref HEAD)

stashing=false
if [ ! -z "$(git status --porcelain)" ]; then
    echo "Detected changes to stash."
    stashing=true
    git stash
fi

git checkout "$branch_name"
read -p "Press any key to continue..."
git checkout "$current_branch"

if [ "$stashing" = true ]; then
    git stash pop
    echo "Changes have been restored."
fi
